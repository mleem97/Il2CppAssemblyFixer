{
  "logging": {
    "writeLogFile": true,
    "logFileName": "fixer.log",
    "minimumLevel": "Debug"
  },
  "telemetry": {
    "enabled": true,
    "endpoint": "__TELEMETRY_ENDPOINT__",
    "format": "loki",
    "username": "__TELEMETRY_USERNAME__",
    "apiKey": "__TELEMETRY_API_KEY__",
    "tenantId": "__TELEMETRY_TENANT_ID__",
    "anonymousId": "",
    "includeAssemblyList": true,
    "includeMachineInfo": true,
    "timeoutSeconds": 5
  }
}
